# ? rd.seed(number) : will generate same number again and again
rd.seed(10)

for i in range(5):
    print(rd.randint(1, 100))

print("---------------------------")

# ? rd.choice() :

l = ["a", "b", 10, 12, 1.5, 2.7]
print(rd.choice(l))
print(rd.choices(l, k=4))

print("---------------------------")

# ! Generate Permutations :- itertools module {permutations(iterable, r=None)}
# ? permutations(iterable, r=None),  product(iterable, repeat=1)

import itertools as it

lst = ["A", "B", "C"]

perms = it.permutations(lst, r=2)
perms_list = list(perms)

print("Permutations: ", perms_list)

for t in perms_list:
    print(t)

print("---------------------------")

# ! Mean, Median & Mode :-

import statistics as st

lst = [6, 8, 4, 9, 3, 10, 8, 11, 5, 7, 8, 4, 2]

mean = st.mean(lst)
median = st.median(lst)
mode = st.mode(lst)

print("Mean: ", mean)
print("Median: ", median)
print("Mode: ", mode)
